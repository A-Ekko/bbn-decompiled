	/**
	 * 获取登陆失败信息
	 * 
	 * @param msg
	 * @return
	 */
	public byte[] getLoginFalse(byte[] msgbytes) {
		this.loger.debug("LOGINFALSE:" + new String(msgbytes));
		byte[] returnbyte = null;
		byte[] dealbyte = new byte[msgbytes.length + 2];
		dealbyte[0] = 1;// 登陆失败
		dealbyte[1] = 0;// 用户权限
		System.arraycopy(msgbytes, 0, dealbyte, 2, msgbytes.length);

		// returnbyte = this.toProtocolBytes(dealbyte, this.Client_Login);
		return returnbyte;
	}

}
