	private void lineInfo(IoSession session,Information info){
		logger.info("获取在线信息 info.getData().length="+info.getData().length);
		//lineController.gameLineInfo(session,info.getRoleId());
		//logger.info("info.getData().length="+info.getData().length);
		if(info.getData()!=null && info.getData().length==4){
    		int account=Integer.parseInt(protocol.ByteToHexLen(info.getData()),16);
    		lineController.gameLineInfo(session,account);
		}
	}
	
	/**
	 * 线开通
	 * @param info
	 */
	private void lineOpen(IoSession session,Information info){
		logger.info("线开通 info.getData().length="+info.getData().length);
		//线id(1U) 端口(2U) IP长度(1U) IP(xU) 名称(XU) 
		if(info.getData()!=null && info.getData().length>4){
    		byte[] lineBytes=new byte[1];
    		byte[] portBytes=new byte[2];
    		byte[] ipLenBytes=new byte[1];
    		
    		int srcPos=0;
    		System.arraycopy(info.getData(),srcPos,lineBytes,0,lineBytes.length);
    		srcPos+=lineBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,portBytes,0,portBytes.length);
    		srcPos+=portBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,ipLenBytes,0,ipLenBytes.length);
    		srcPos+=ipLenBytes.length;
    		
    		int line=Integer.parseInt(protocol.ByteToHexLen(lineBytes),16);
    		int port=Integer.parseInt(protocol.ByteToHexLen(portBytes),16);
    		int ipLen=Integer.parseInt(protocol.ByteToHexLen(ipLenBytes),16);
    		
			byte[] ipBytes=new byte[ipLen];
			byte[] nameBytes=new byte[info.getData().length-lineBytes.length-portBytes.length-ipLenBytes.length-ipBytes.length];
			
    		
    		
    		System.arraycopy(info.getData(),srcPos,ipBytes,0,ipBytes.length);
    		srcPos+=ipBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,nameBytes,0,nameBytes.length);
    		
    		String ip= new String(ipBytes);
    		String name=null;
			try {name = new String(nameBytes,"utf-8");} catch (UnsupportedEncodingException e) {e.printStackTrace();}
				
    		lineController.lineOpen(line,ip,port,name,session);
		}
	}
	
	public void lineClose(Line line){
		lineController.lineClose(line);
	}
	
	/**
	 * 玩家上线
	 * @param info
	 */
	private void online(IoSession session,Information info){
		//玩家公会Id(4u) 玩家阵营Id(4u) 玩家所在的线(4u) 玩家所在的地图Id(4u) 玩家名称长度(1u) 玩家名称(xu) 玩家喇叭(xu)[喇叭1Id:喇叭1个数,喇叭2Id:喇叭2个数........]
		//logger.info("玩家["+info.getRoleId()+"]上线info.getData().length="+info.getData().length);
		if(info.getData()!=null){
			LinePlayerVO linePlayerVo=(LinePlayerVO)amf.readData(info.getData());
			
			if(linePlayerVo!=null){
				
				int guild=linePlayerVo.gid;
	    		int camp=linePlayerVo.cid;
	    		int map=linePlayerVo.mid;
	    		int line=linePlayerVo.l;
	    		String name=linePlayerVo.pn;
				String bugleStr=linePlayerVo.bn;
				List<Integer> friends=linePlayerVo.fid;
				int userId=linePlayerVo.uid;
				
	    		Map<Integer,Integer> bugleMap=new HashMap<Integer,Integer>();
	    		if(bugleStr!=null){
	    			String[] bugleNumber=bugleStr.split(",");
	    			for(int i=0;i<bugleNumber.length;i++){
	    				String bugleTeam=bugleNumber[i];
	    				bugleMap.put(Integer.parseInt(bugleTeam.substring(0,bugleTeam.indexOf(":"))), Integer.parseInt(bugleTeam.substring(bugleTeam.lastIndexOf(":")+1)));
	    			}
	    		}
	    		//logger.info("玩家ID["+info.getRoleId()+"] 玩家账号["+userId+"] 玩家名称["+name+"] 工会ID["+guild+"] 玩家阵营["+camp+"] 玩家所在的地图ID["+map+"] 玩家进入游戏的线["+line+"] 玩家的好友ID列表"+friends+" 玩家身上的喇叭总数"+bugleMap+"");
	    		playerController.online(session,info.getRoleId(), name, guild, camp, map, line, bugleMap,friends,userId);
			}
			
			StringBuffer debugmsg = new StringBuffer();
			
			debugmsg.append("现在进程PID[");
			debugmsg.append(VirtualMachine.getPid());
			debugmsg.append("]总内存:");
			debugmsg.append(Runtime.getRuntime().totalMemory()/1024);
			debugmsg.append("K,已使用内存:");
			debugmsg.append((Runtime.getRuntime().totalMemory()-Runtime.getRuntime().freeMemory())/1024);
			debugmsg.append("K,空闲内存:");
			debugmsg.append(Runtime.getRuntime().freeMemory()/1024);
			debugmsg.append("K");
			debugmsg.append("当前在线的总人数:"+SystemStore.players.size());
			
			logger.info(debugmsg);
		}
	}
	
	/**
	 * 玩家下线
	 * @param info 
	 */
	private void downline(Information info){
		//玩家id(4u)
		//logger.info("玩家["+info.getRoleId()+"]下线info.getData().length="+info.getData().length);
		playerController.downline(SystemStore.players.remove(info.getRoleId()));
	}
	
