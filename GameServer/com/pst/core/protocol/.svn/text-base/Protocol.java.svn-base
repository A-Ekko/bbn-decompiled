package com.pst.core.protocol;

import java.io.ByteArrayOutputStream;
import java.io.OutputStreamWriter;

/**
 * 本类只提供协议所用到的各种函数
 * 
 * @author Administrator
 * 
 */
public class Protocol {

	public static String PROTOCAL_ENCODEDEFAULT = "utf-8";

	/**
	 * 将BYTE转换成unsign表示的形式(0-255)
	 * 
	 * @param thebyte
	 * @return
	 */
	protected int ToUnsignByteInt(byte _thebyte) {

		if (_thebyte < 0) {
			return 256 + _thebyte;
		} else {
			return _thebyte;
		}
	}

	/**
	 * 将无符号数表示的数字(0-255)转换成byte(-128->127)
	 * 
	 * @param num
	 * @return
	 */
	public byte UnsignByteToByte(int _num) {
		byte targetbyte = 0;
		if (_num < 0 || _num > 255) {
			return targetbyte;
		}

		if (_num > 127) {
			targetbyte = (byte) (_num - 256);
		} else {
			targetbyte = (byte) _num;
		}

		return targetbyte;
	}

	/**
	 * 调试输出接收到的包信息
	 * 
	 * @param getbytes
	 * @param UnsignMode
	 *            输出结果时是否转换为Unsign数字(0-255)
	 */
	public String debugReciveByte(byte[] getbytes, boolean UnsignMode) {
		if (getbytes.length == 0) {
			return "";
		}
		int colnum = 30, i = 0, j = 0, posoffset = 0;
		int rownum = (int) (getbytes.length / colnum);
		if (getbytes.length % colnum > 0) {
			rownum++;
		}
		// this.TM.TraceMsg("==================ROWNUM:"+rownum+",bytelen:"+
		// getbytes.length+"==========");
		StringBuffer debugstr = new StringBuffer();
		debugstr.append("==============debugstart=================\r\n");
		for (i = 0; i < rownum; i++) {
			// debugstr.delete(0, debugstr.length());
			debugstr.append("row:").append(i).append(":");
			for (j = 0; j < colnum; j++) {
				posoffset = i * colnum + j;
				if (posoffset >= getbytes.length) {
					break;
				}
				if (UnsignMode == true) {
					debugstr.append("[").append(
							String.valueOf((i * colnum + j))).append("]")
							.append(
									String.valueOf(this
											.ToUnsignByteInt(getbytes[i
													* colnum + j])))
							.append(",");
				} else {
					debugstr.append("[").append(
							String.valueOf((i * colnum + j))).append("]")
							.append(String.valueOf(getbytes[i * colnum + j]))
							.append(",");
				}
			}

			debugstr.append("\r\n");
			// this.TM.TraceMsg("r"+(i+1)+"->"+debugstr.toString());

		}
		debugstr.append("===============debugend================\r\n");

		return debugstr.toString();
	}

	/**
	 * 将协议中截取到的表示包长度的byte[]转换成十六进制表示形式
	 * 
	 * @param bytes
	 * @return String 十六进制数,双位表示形式(0-255,00-ff)
	 */
	public String ByteToHexLen(byte[] _bytes) {
		StringBuffer HexNum = new StringBuffer();
		int i = 0, unsignbyte = 0;
		for (i = 0; i < _bytes.length; i++) {
			unsignbyte = 0;
			unsignbyte = this.ToUnsignByteInt(_bytes[i]);
			if (unsignbyte < 16) {
				HexNum.append("0");
			}// 不够两位，填充一个0
			HexNum.append(Integer.toHexString(unsignbyte));
		}

		return HexNum.toString();
	}

	/**
	 * 把一个整数(<=FFFF)用十六进制表示并转换成byte
	 * 
	 * @param len
	 * @return
	 */
	public byte[] ToUnsignBLenByte(int _len) {
		byte[] returnbytes = null;
		int i = 0;
		int bytenum = 0;
		StringBuffer HexLen = new StringBuffer();
		HexLen.append(Integer.toHexString(_len));
		// 长度不够2的倍数，补位
		if (HexLen.length() % 2 > 0) {
			HexLen.insert(0, "0");
		}
		// 不够4位的补够4位
		if (HexLen.length() == 2) {
			HexLen.insert(0, "00");
		}

		returnbytes = new byte[HexLen.length() / 2];
		for (i = 0; i < HexLen.length() / 2; i++) {
			bytenum = Integer.parseInt(HexLen.substring(i * 2, i * 2 + 2), 16);
			returnbytes[i] = this.UnsignByteToByte(bytenum);
		}

		return returnbytes;
	}

	/**
	 * 把一个数组填充到指定大小
	 * 
	 * @param cmdbytes
	 * @param targetlen
	 * @return
	 */
	public byte[] FillBytes(byte[] _cmdbytes, int _targetlen) {
		byte[] returnbytes = new byte[_targetlen];

		if (_cmdbytes.length > _targetlen) {
			// 目标长度比现有数组长度短，截取头几位放进去
			System.arraycopy(_cmdbytes, 0, returnbytes, 0, _targetlen);
		} else {
			System.arraycopy(_cmdbytes, 0, returnbytes,
					(_targetlen - _cmdbytes.length), _cmdbytes.length);
		}

		return returnbytes;
	}

	public byte[] StringIconv(String _msg) {

		return this.StringIconv(_msg, this.PROTOCAL_ENCODEDEFAULT);
	}

	/**
	 * 把一个命令转换成指定的编码格式
	 * 
	 * @param msg
	 * @return
	 */
	public byte[] StringIconv(String _msg, String _chatset) {
		ByteArrayOutputStream sbaos = new ByteArrayOutputStream();// 用户字符串编码转换
		OutputStreamWriter sosw = null;
		byte[] MSGBYTE = new byte[0];
		try {
			sosw = new OutputStreamWriter(sbaos, _chatset);
			sosw.write(_msg.toString());
			sosw.flush();

			MSGBYTE = sbaos.toByteArray();

		} catch (Exception e) {
		}

		try {
			sosw.close();
			sbaos.close();
		} catch (Exception e) {
		}

		return MSGBYTE;
	}
}
