package com.pst.core.shutdown;

import org.apache.log4j.Logger;

import com.pst.core.config.SystemConfig;

public class ShutdownHook implements Runnable{

	@Override
	public void run() {
		Logger logger=Logger.getLogger(ShutdownHook.class);
		
		logger.info("启动关闭进程....................");
		unbind(logger);
	}
	
	private void unbind(Logger logger){
		try{
			SystemConfig.acceptor.unbind();
			logger.info("关闭端口数据接收监听器...........");
		}catch (Exception e) {
			e.printStackTrace();
		}
	}

}
