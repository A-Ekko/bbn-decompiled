	/**
	 * 发送系统信息
	 * @param result	返回内容
	 * @return 协议命令
	 */
	public byte[] systemResult(String result){
		byte[] cmdBytes =null;
		try{
			cmdBytes=result.getBytes(Protocol.PROTOCAL_ENCODEDEFAULT);
		}catch(UnsupportedEncodingException e){
			e.printStackTrace();
		}
		return protocol.packProtocolBytes(cmdBytes,Command.systemResult);
	}
	
	  /**
	   * 系统消息
	   * @param message
	   * @return
	   */
	  public byte[] sysMessage(byte[] message){
		  byte[] totalByte = new byte[message.length];
		  
		  int poset=0;
		  System.arraycopy(message, 0, totalByte, poset, message.length);
		  
		  return protocol.packProtocolBytes(totalByte, Command.sysMessage);
	  }
	  
	  /**
	   * 改变战场状态
	   * @param data
	   * @return
	   */
	  public byte[] warInfo(byte[] data){
		  return protocol.packToServerProtocolBytes(data, Command.toGserver_warInfo, 1, 1);
	  }
