package com.pst.db.dao;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;

import com.pst.db.ConnectionPoolManager;

public class MapDao {
	
	public List<Integer> getMaps() {
		Connection con = ConnectionPoolManager.getConnectionPool().getConnection();
		Statement stmt = null;
		ResultSet rs = null;
		String sql = "SELECT m.id FROM map AS m";
		List<Integer> maps = new ArrayList<Integer>();
		try {
			stmt = con.createStatement();
			rs = stmt.executeQuery(sql);
			while (rs.next()) {
				maps.add(rs.getInt("m.id"));
			}
		} catch (SQLException e) {
			e.printStackTrace();
		} finally {
			try {
				if(rs != null)rs.close();
				if(stmt != null)stmt.close();
				if(con != null)con.close();
			} catch (SQLException e) {
				e.printStackTrace();
			}
		}
		return maps;
	}
}
