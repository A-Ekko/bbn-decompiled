package com.pst.core.protocol;

import org.apache.mina.core.buffer.IoBuffer;
import org.apache.mina.core.session.IoSession;
import org.apache.mina.filter.codec.ProtocolEncoderAdapter;
import org.apache.mina.filter.codec.ProtocolEncoderOutput;

public class F002ProtocolEncoder extends ProtocolEncoderAdapter {

	public void encode(IoSession _session, Object _message,
			ProtocolEncoderOutput _feout) {
		byte[] messagebytes = (byte[]) _message;
		IoBuffer bytebuff = IoBuffer.allocate(messagebytes.length);
		bytebuff.put(messagebytes);
		bytebuff.flip();
		_feout.write(bytebuff);
	}
}
