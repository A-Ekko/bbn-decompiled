	public void lineClose(Line line){
		line.setStatus(0);
	}
	
	public void gameLineInfo(IoSession session,int account){
		logger.info("玩家账号["+account+"]获取线的信息");
		
		
		otherLineAccountConnect(account);//通知各线玩家获取游戏线的信息
		
		
		ServerInfo si=new ServerInfo();
		si.n=SystemStore.server;
		
		si.l=new ArrayList<LineInfo>();
		
		LineInfo info;
		LineInfo minLineInfo=null;
		Line line;
		int min=99999999;
		int playerNum=0;
		for(int i=0;i<SystemStore.lines.size();i++){
			line=SystemStore.lines.get(i);
			if(line!=null){
				info=new LineInfo();
				info.ip=line.getIp();
				info.name=line.getName();
				info.port=line.getPort();
				if(line.getStatus()!=0){
					playerNum=countLineNum(line.getId());
					
					if(playerNum<min){
						min=playerNum;
						minLineInfo=info;
					}
					
					if(playerNum<SystemConfig.good){
						info.status=1;
					}else if(playerNum>=SystemConfig.good && playerNum<SystemConfig.bad){
						info.status=2;
					}else if(playerNum>=SystemConfig.bad){
						info.status=3;
					}
				}else{
					info.status=line.getStatus();
				}
				
				si.l.add(info);	
			}
			
			if(minLineInfo!=null){
				boolean f=si.l.remove(minLineInfo);
				if(f){
					si.l.add(0,minLineInfo);
				}
			}
		}
		
		session.write(commandWrapper.gameLineInfo(si));
	}
	
	/**
	 * 计算某一个线上在线人数的总数
	 * @param lineId	线号
	 * @return	人数
	 */
	private int countLineNum(int lineId){
		int playerNum=0;
		Iterator it=SystemStore.players.keySet().iterator();
		Integer id;
		Player player;
		while(it.hasNext()){
			id=(Integer)it.next();
			player=SystemStore.players.get(id);
			if(player!=null && lineId==player.getLine()){
				playerNum++;
			}
		}
		return playerNum;
	}
	
