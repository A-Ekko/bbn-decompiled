	/**
	 * 分析接收到的命令bytes,这里已经过滤掉协议头等信息，从权令位开始处理
	 * 
	 * @param cmdbody
	 * @return 客户端信息
	 */
	public Information parseCmdBytes(byte[] cmdbody) {
		// this.loger.debug(this.debugReciveByte(cmdbody, true));
		// this.loger.debug("parseCmdBytes:"+cmdbody.length);
		if (cmdbody.length < 8) {
			// [2(pt)+4(uid)+2(actiontype) = 8]
			this.loger.info("{ParseCmdBytes}Package Len Too Short");
			return null;
		}
		
		byte[] byte_pt = new byte[2];//权令
		//byte[] byte_special = new byte[1];// 特殊用途数据位
		byte[] byte_uid = new byte[4];// 用户ID
		byte[] byte_action = new byte[2];// 操作类型
		//byte[] byte_cmdbody = new byte[cmdbody.length- (byte_pt.length + byte_special.length + byte_uid.length + byte_action.length)];
		byte[] byte_cmdbody = new byte[cmdbody.length- (byte_pt.length + byte_uid.length + byte_action.length)];

		int readpos = 0;
		// 获取权令
		System.arraycopy(cmdbody, readpos, byte_pt, 0, byte_pt.length);
		readpos += byte_pt.length;

		// 特殊用途位
//		System.arraycopy(cmdbody, readpos, byte_special, 0,byte_special.length);
//		readpos += byte_special.length;
		
		// 获取用户ID
		System.arraycopy(cmdbody, readpos, byte_uid, 0, byte_uid.length);
		readpos += byte_uid.length;
		// 获取操作类型
		System.arraycopy(cmdbody, readpos, byte_action, 0, byte_action.length);
		readpos += byte_action.length;
		// 获取cmdbody
		if (cmdbody.length > readpos) {
			System.arraycopy(cmdbody, readpos, byte_cmdbody, 0,byte_cmdbody.length);
		}
		
		int pt=Integer.parseInt(this.ByteToHexLen(byte_pt), 16);// 权令
		int userId=Integer.parseInt(this.ByteToHexLen(byte_uid), 16);//用户ID
		String type=this.ByteToHexLen(byte_action);//操作类型
		
		return new Information(pt,userId,type,byte_cmdbody);
	}

