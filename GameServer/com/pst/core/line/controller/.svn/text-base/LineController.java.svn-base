	/**
	 * 线开通
	 * @param id 线Id
	 */
	public void lineOpen(int id,String ip,int port,String name,IoSession session){
		Line line;
		boolean has=false;
		synchronized (SystemStore.lines) {
			for(int i=0;i<SystemStore.lines.size();i++){
				line=SystemStore.lines.get(i);
				if(line!=null){
					if(line.getId()==id){
						if(line.getSession()!=null && line.getSession().isConnected() && !line.getSession().isClosing()){
							line.getSession().close(false);
						}
						line.setSession(session);
						line.setIp(ip);
						line.setPort(port);
						line.setName(name);
						line.setStatus(1);
						
						has=true;
						break;
					}
				}else{
					SystemStore.lines.remove(i--);
				}
			}
			if(!has){
				Line newLine=new Line();
				
				newLine.setId(id);
				newLine.setSession(session);
				newLine.setIp(ip);
				newLine.setPort(port);
				newLine.setName(name);
				newLine.setStatus(1);
				
				boolean add=false;
				for(int i=0;i<SystemStore.lines.size();i++){
					line=SystemStore.lines.get(i);
					if(line.getId()>id){
						SystemStore.lines.add(i,newLine);
						add=true;
						break;
					}
				}
				if(!add){
					SystemStore.lines.add(newLine);
				}
			}
			logger.info("线["+id+" : "+name+"]开通,IP["+ip+"],端点["+port+"]");
		}
	}
	
	public void createGuild(IoSession session,byte[] data){
		Line line;
		IoSession temp;
		byte[] cmdBytes=commandWrapper.createGuild(data);
		for(int i=0;i<SystemStore.lines.size();i++){
			line=SystemStore.lines.get(i);
			if(line!=null){
				temp=line.getSession();
				if(temp!=null && temp!=session){
					temp.write(cmdBytes);
				}
			}
		}
	}
	
