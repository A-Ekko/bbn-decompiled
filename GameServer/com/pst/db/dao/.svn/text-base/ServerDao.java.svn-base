package com.pst.db.dao;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

import com.pst.db.ConnectionPoolManager;

public class ServerDao {
	
	public String getServerName() {
		String name=null;
		Connection con = ConnectionPoolManager.getConnectionPool().getConnection();
		Statement stmt = null;
		ResultSet rs = null;
		String sql = "select c.value from config as c where c.key='server_name'";
		try {
			stmt = con.createStatement();
			rs = stmt.executeQuery(sql);
			while (rs.next()) {
				name=rs.getString("c.value");
			}
		} catch (SQLException e) {
			e.printStackTrace();
		} finally {
			try {
				if (rs != null)
					rs.close();
				if (stmt != null)
					stmt.close();
				if (con != null)
					con.close();
			} catch (SQLException e) {
				e.printStackTrace();
			}
		}
		return name;
	}
}
