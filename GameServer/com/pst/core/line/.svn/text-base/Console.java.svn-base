	public void action(IoSession session,byte[] data){
		Information info=protocol.parseCmdBytes(data);
		//logger.info("info="+info.getType());
		if(Command.changeMap.equals(info.getType())){
			changeMap(session,info);
		}else if(Command.lineChat.equals(info.getType())){
			chat(info);
		}else if(Command.online.equals(info.getType())){
			online(session,info);
		}else if(Command.downline.equals(info.getType())){
			downline(info);
		}else if(Command.connectGame.equals(info.getType())){
			connectGame(session,info);
		}else if(Command.lineInfo.equals(info.getType())){
			lineInfo(session,info);
		}else if(Command.changeBugle.equals(info.getType())){
			changeBugle(info);
		}else if(Command.friendOnOrDownline.equals(info.getType())){
			friendOnOrDownline(info);
		}else if(Command.createTeam.equals(info.getType())){
			createTeam(info);
		}else if(Command.joinTeam.equals(info.getType())){
			joinTeam(info);
		}else if(Command.leaveTeam.equals(info.getType())){
			leaveTeam(info);
		}else if(Command.lineOpen.equals(info.getType())){
			lineOpen(session,info);
		}else if(Command.client_sysMessage.equals(info.getType())){///系统消息
    		sysMessage(session,info);
    	}else if(Command.fromGserver_createGuild.equals(info.getType())){
    		logger.info("创建公会");
    		createGuild(session,info);
    	}else if(Command.fromGserver_addApplyJionGuild.equals(info.getType())){
    		logger.info("玩家添加公会申请人");
    		addApplyJionGuild(session,info);
    	}else if(Command.fromGserver_addGuildRole.equals(info.getType())){
    		logger.info("添加玩家进入公会");
    		addGuildRole(session,info);
    	}else if(Command.fromGserver_addRoleGuild.equals(info.getType())){
    		logger.info("添加玩家的公会信息");
    		addRoleGuild(session,info);
    	}else if(Command.fromGserver_rejectApplyRole.equals(info.getType())){
    		logger.info("拒绝玩家申请");
    		rejectApplyRole(session,info);
    	}else if(Command.fromGserver_rejectRole.equals(info.getType())){
    		logger.info("剔除玩家出公会");
    		rejectRole(session,info);
    	}else if(Command.fromGserver_dismissGuild.equals(info.getType())){
    		logger.info("解散工会");
    		dismissGuild(session,info);
    	}
    	else if(Command.fromGserver_changeGuildInfo.equals(info.getType())){
    		logger.info("修改公会信息");
    		changeGuildInfo(session,info);
    	}
		
    	else if(Command.fromGserver_careteTitle.equals(info.getType())){
    		logger.info("创建职位");
    		careteTitle(session,info);
    	}
    	else if(Command.fromGserver_alertTitle.equals(info.getType())){
    		logger.info("修改职位");
    		alertTitle(session,info);
    	}
    	else if(Command.fromGserver_delTitle.equals(info.getType())){
    		logger.info("删除职位");
    		delTitle(session,info);
    	}
    	else if(Command.fromGserver_checkRoleInfo.equals(info.getType())){    		
    		logger.info("跨线查看玩家信息");
    		checkRoleInfo(session,info);
    	}
    	else if(Command.fromGserver_radioKillMonster.equals(info.getType())){
    		logger.info("跨线杀死怪物的广播");
    		radioKillMonster(session,info);
    	}
    	else if(Command.fromGserver_findRoleInfo.equals(info.getType())){
    		logger.info("跨线查询玩家的基本信息");
    		findRoleInfo(session,info);
    	}
    	else if(Command.fromGserver_warInfo.equals(info.getType())){
    		logger.info("跨线改变战场状态");
    		warInfo(session,info);
    	}
    	else if(Command.fromGserver_horn.equals(info.getType()))
    	{
    		logger.info("跨线小喇叭");
    		this.horn(info);
    		
    	}

	}
	
	
