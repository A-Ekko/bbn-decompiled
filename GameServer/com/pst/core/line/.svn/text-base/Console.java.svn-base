	/**
	 * 组队
	 * @param info
	 */
	private void createTeam(Information info){
		//队友Id(4u) 队伍Id(xu)
		//logger.info("玩家["+info.getRoleId()+"]组队info.getData().length="+info.getData().length);
		if(info.getData()!=null && info.getData().length>4){
			byte[] partnerBytes=new byte[4];
			byte[] teamBytes=new byte[info.getData().length-partnerBytes.length];
			
    		int srcPos=0;
    		System.arraycopy(info.getData(),srcPos,partnerBytes,0,partnerBytes.length);
    		srcPos+=partnerBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,teamBytes,0,teamBytes.length);
    		
    		String teamId=null;
    		int partnerId=Integer.parseInt(protocol.ByteToHexLen(partnerBytes),16);
    		try {teamId=new String(teamBytes,Protocol.PROTOCAL_ENCODEDEFAULT);} catch (UnsupportedEncodingException e) {e.printStackTrace();}
			
			playerController.createTeam(info.getRoleId(), partnerId, teamId);
		}
	}
	
	/**
	 * 加入队伍
	 * @param info
	 */
	private void joinTeam(Information info){
		//队伍Id(xu)
		//logger.info("玩家["+info.getRoleId()+"]加入队伍info.getData().length="+info.getData().length);
		if(info.getData()!=null && info.getData().length>1){
    		String teamId=null;
    		try {teamId=new String(info.getData(),Protocol.PROTOCAL_ENCODEDEFAULT);} catch (UnsupportedEncodingException e) {e.printStackTrace();}
			playerController.joinTeam(info.getRoleId(),teamId);
		}
	}
	
	/**
	 * 离开队伍
	 * @param info
	 */
	private void leaveTeam(Information info){
		//队伍Id(xu)
		//logger.info("玩家["+info.getRoleId()+"]离开队伍info.getData().length="+info.getData().length);
		if(info.getData()!=null && info.getData().length>1){
			String teamId=null;
    		try {teamId=new String(info.getData(),Protocol.PROTOCAL_ENCODEDEFAULT);} catch (UnsupportedEncodingException e) {e.printStackTrace();}
			playerController.leaveTeam(info.getRoleId(),teamId);
		}
	}
	
	/**
	 * 好友上下线
	 * @param info
	 */
	private void friendOnOrDownline(Information info){
		//上下线类型(1u)[0:下线,1:上线] 好友列表(xu)
		
		//logger.info("好友["+info.getRoleId()+"]上下线info.getData().length="+info.getData().length);
		
		if(info.getData()!=null && info.getData().length>1){
			byte[] typeBytes=new byte[1];
			byte[] friendBytes=new byte[info.getData().length-typeBytes.length];
			
			int srcPos=0;
    		
    		System.arraycopy(info.getData(),srcPos,typeBytes,0,typeBytes.length);
    		srcPos+=typeBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,friendBytes,0,friendBytes.length);
    		
    		int type=Integer.parseInt(protocol.ByteToHexLen(typeBytes),16);
    		
    		String friend=null;
    		try {friend=new String(friendBytes,Protocol.PROTOCAL_ENCODEDEFAULT);} catch (UnsupportedEncodingException e) {e.printStackTrace();}
    		Integer[] receiver=null;
    		if(friend!=null){
    			String[] fs=friend.split(",");
    			receiver=new Integer[fs.length];
    			for(int i=0;i<fs.length;i++){
    				receiver[i]=Integer.parseInt(fs[i]);
    			}
    			playerController.friendOnOrDownline(info.getRoleId(),receiver,type);
    		}
    		
		}
	}
	
	/**
	 * 玩家转换地图
	 * @param info
	 */
	private void changeMap(IoSession session,Information info){
		//地图id(4u)
		
		//logger.info("玩家["+info.getRoleId()+"]转换地图info.getData().length="+info.getData().length);
		
		if(info.getData()!=null && info.getData().length==4){
			//byte[] idBytes=new byte[4];
			byte[] mapBytes=new byte[4];
			
			int srcPos=0;
    		//System.arraycopy(info.getData(),srcPos,idBytes,0,idBytes.length);
    		//srcPos+=idBytes.length;
    		
    		System.arraycopy(info.getData(),srcPos,mapBytes,0,mapBytes.length);
			
    		//int playerId=Integer.parseInt(protocol.ByteToHexLen(idBytes),16);
    		int map=Integer.parseInt(protocol.ByteToHexLen(mapBytes),16);
    		
    		playerController.changeMap(session,info.getRoleId(), map);
    		
		}
	}
	
	
	
	/**
	 * 玩家聊天
	 * @param info
	 */
	private void chat(Information info){
		//聊天类型[0,私聊,1:世界,2:场景,3:队伍,4:帮派,5:阵营]	聊天对象名称长度(1u)	聊天对象名称(xu) 数据对象长度(1u) 数据对象(xu) 聊天内容(xu)
		
		//logger.info("玩家["+info.getRoleId()+"]聊天info.getData().length="+info.getData().length);
		
		if(info.getData()!=null && info.getData().length>2){
    		
    		byte[] typeByte=new byte[1];
    		byte[] nameLenBytes=new byte[1];
    		byte[] dataLenByte=new byte[1];
    		
    		int srcPos=0;
    		System.arraycopy(info.getData(),srcPos,typeByte,0,typeByte.length);
    		srcPos+=typeByte.length;
    		
    		System.arraycopy(info.getData(),srcPos,nameLenBytes,0,nameLenBytes.length);
    		srcPos+=nameLenBytes.length;
    		
    		int nameLen=Integer.parseInt(protocol.ByteToHexLen(nameLenBytes),16);
    		
    		byte[] nameBytes=new byte[nameLen];
    		System.arraycopy(info.getData(),srcPos,nameBytes,0, nameBytes.length);
    		srcPos+=nameBytes.length;
    		
    		System.arraycopy(info.getData(), srcPos, dataLenByte, 0, dataLenByte.length);
    		srcPos+=dataLenByte.length;
    		
    		int dataLen=Integer.parseInt(protocol.ByteToHexLen(dataLenByte),16);
    		byte[] dataByte=new byte[dataLen];
    		
    		System.arraycopy(info.getData(), srcPos, dataByte, 0, dataByte.length);
    		srcPos+=dataByte.length;
    		
    		//System.out.println("聊天数据总长度="+info.getData().length+" type长度"+typeByte.length+" 名称长度"+nameLenBytes.length+" 名称对象长度"+nameLen+" 数据对象长度"+dataLenByte.length+" 数据长度"+dataByte.length);
    		
    		byte[] contentByes=new byte[info.getData().length-typeByte.length-nameLenBytes.length-nameLen-dataLenByte.length-dataByte.length];
    		System.arraycopy(info.getData(),srcPos,contentByes,0, contentByes.length);
    		
    		int type=Integer.parseInt(protocol.ByteToHexLen(typeByte),16);
    		String target=null;
    		try {target=new String(nameBytes,Protocol.PROTOCAL_ENCODEDEFAULT);} catch (UnsupportedEncodingException e) {e.printStackTrace();}
    		String dataStr=null;
    		try{
    			dataStr=new String(dataByte,Protocol.PROTOCAL_ENCODEDEFAULT);
    		}catch(UnsupportedEncodingException e){
    			e.printStackTrace();
    		}
    		
    		//logger.info("玩家["+info.getRoleId()+"]聊天状态["+type+"(0,私聊,1:世界,2:场景,3:队伍,4:帮派,5:阵营)] 聊天对象["+target+"(如果是世界聊天是为喇叭ID)] 聊天的长度["+contentByes.length+"]");
    		
    		chatController.chat(info.getRoleId(),type,target,contentByes,dataStr);
    	}
	}
	
	/**
	 * 玩家使用小喇叭
	 * @param info
	 */
	private void horn(Information info)
	{
		//聊天类型[0,私聊,1:世界,2:场景,3:队伍,4:帮派,5:阵营]	聊天对象名称长度(1u)	聊天对象名称(xu) 数据对象长度(1u) 数据对象(xu) 聊天内容(xu)
		
		//logger.info("玩家["+info.getRoleId()+"]聊天info.getData().length="+info.getData().length);
		
		if(info.getData()!=null && info.getData().length>2)
		{
			
			
    		byte[] typeByte=new byte[1];
    		byte[] nameLenBytes=new byte[1];
    		byte[] dataLenByte=new byte[1];
    		
    		int srcPos=0;
    		System.arraycopy(info.getData(),srcPos,typeByte,0,typeByte.length);
    		srcPos+=typeByte.length;
    		
    		System.arraycopy(info.getData(),srcPos,nameLenBytes,0,nameLenBytes.length);
    		srcPos+=nameLenBytes.length;
    		
    		int nameLen=Integer.parseInt(protocol.ByteToHexLen(nameLenBytes),16);
    		
    		byte[] nameBytes=new byte[nameLen];
    		System.arraycopy(info.getData(),srcPos,nameBytes,0, nameBytes.length);
    		srcPos+=nameBytes.length;
    		
    		System.arraycopy(info.getData(), srcPos, dataLenByte, 0, dataLenByte.length);
    		srcPos+=dataLenByte.length;
    		
    		int dataLen=Integer.parseInt(protocol.ByteToHexLen(dataLenByte),16);
    		byte[] dataByte=new byte[dataLen];
    		
    		System.arraycopy(info.getData(), srcPos, dataByte, 0, dataByte.length);
    		srcPos+=dataByte.length;
    		
    		//System.out.println("聊天数据总长度="+info.getData().length+" type长度"+typeByte.length+" 名称长度"+nameLenBytes.length+" 名称对象长度"+nameLen+" 数据对象长度"+dataLenByte.length+" 数据长度"+dataByte.length);
    		
    		byte[] contentByes = new byte[info.getData().length - typeByte.length-nameLenBytes.length-dataLenByte.length-dataByte.length-nameBytes.length];
    		System.arraycopy(info.getData(),srcPos,contentByes,0, contentByes.length);
    		
    		int type=Integer.parseInt(protocol.ByteToHexLen(typeByte),16);
    		
    		String target=null;
    		String dataStr=null;
    		
    		try
    		{
    			target= new String(nameBytes,Protocol.PROTOCAL_ENCODEDEFAULT);
    			dataStr=new String(dataByte,Protocol.PROTOCAL_ENCODEDEFAULT);
    		} 
    		catch(UnsupportedEncodingException e) 
    		{
    			e.printStackTrace();
    		}
    		
    		/**
    		 * 注:这里使用 pt因为pt,这里的聊天必须使用pt方式
    		 */
    		chatController.horn(info.getPt(),type,target,contentByes,dataStr);
    	}
	}
	
	private void changeBugle(Information info){
		//喇叭数量(2u) 玩家喇叭(xu)[喇叭1Id:喇叭1个数,喇叭2Id:喇叭2个数........]
		logger.info("玩家["+info.getRoleId()+"]喇叭数量info.getData().length="+info.getData().length);
		
		if(info.getData()!=null){
			String bugleNumber=null;
			try {
				bugleNumber=new String(info.getData(),Protocol.PROTOCAL_ENCODEDEFAULT);
			} catch (UnsupportedEncodingException e) {
				e.printStackTrace();
			}
			if(bugleNumber!=null){
				Map<Integer,Integer> tMap=new HashMap<Integer,Integer>();
				String[] bugleStr=bugleNumber.split(",");
				for(int i=0;i<bugleStr.length;i++){
					String bugleTeam=bugleStr[i];
					tMap.put(Integer.parseInt(bugleTeam.substring(0,bugleTeam.indexOf(":"))), Integer.parseInt(bugleTeam.substring(bugleTeam.lastIndexOf(":")+1)));
				}
				playerController.bugleNumber(info.getRoleId(),tMap);
			}
		}
	}
	
	/**
	 * 系统消息
	 * @param info
	 */
	private void sysMessage(IoSession session,Information info){
		if(info.getData() != null){
			sysMsgController.sysMessage(info.getData(),info.getRoleId(),true,session);
		}else{
			sysMsgController.sysMessage(info.getData(),info.getRoleId(),false,session);
		}
	}
	
